{% set etcd_scheme = 'https' if (etcd_tls_enabled | bool) else 'http' %}
ETCD_NAME="{{ inventory_hostname }}"
ETCD_DATA_DIR="{{ etcd_data_dir }}"
ETCD_LISTEN_PEER_URLS="{{ etcd_scheme }}://{{ ansible_host }}:{{ etcd_peer_port }}"
ETCD_LISTEN_CLIENT_URLS="{{ etcd_scheme }}://127.0.0.1:{{ etcd_client_port }},{{ etcd_scheme }}://{{ ansible_host }}:{{ etcd_client_port }}"
ETCD_INITIAL_ADVERTISE_PEER_URLS="{{ etcd_scheme }}://{{ ansible_host }}:{{ etcd_peer_port }}"
ETCD_ADVERTISE_CLIENT_URLS="{{ etcd_scheme }}://{{ ansible_host }}:{{ etcd_client_port }}"
ETCD_INITIAL_CLUSTER="{% for host in groups['postgresql_cluster'] %}{{ host }}={{ etcd_scheme }}://{{ hostvars[host].ansible_host }}:{{ etcd_peer_port }}{% if not loop.last %},{% endif %}{% endfor %}"
ETCD_INITIAL_CLUSTER_STATE="new"
ETCD_INITIAL_CLUSTER_TOKEN="{{ etcd_cluster_token }}"
ETCD_AUTO_COMPACTION_RETENTION="1"
ETCD_QUOTA_BACKEND_BYTES="8589934592"
{% if etcd_tls_enabled | bool %}
ETCD_CLIENT_CERT_AUTH="true"
ETCD_TRUSTED_CA_FILE="{{ etcd_tls_ca_file }}"
ETCD_CERT_FILE="{{ etcd_tls_server_cert_file }}"
ETCD_KEY_FILE="{{ etcd_tls_server_key_file }}"
ETCD_PEER_CLIENT_CERT_AUTH="true"
ETCD_PEER_TRUSTED_CA_FILE="{{ etcd_tls_ca_file }}"
ETCD_PEER_CERT_FILE="{{ etcd_tls_peer_cert_file }}"
ETCD_PEER_KEY_FILE="{{ etcd_tls_peer_key_file }}"
{% endif %}
