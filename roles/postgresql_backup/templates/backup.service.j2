[Unit]
Description=PostgreSQL HA {{ item.kind }} backup on current primary
After=network-online.target patroni.service
Wants=network-online.target
RequiresMountsFor={{ postgresql_backup_repository_mount }}

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/local/sbin/pg-ha-backup {{ item.kind }}
TimeoutStartSec=infinity
Nice=10
UMask=0077
NoNewPrivileges=true
