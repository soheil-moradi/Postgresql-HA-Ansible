[Unit]
Description=Patroni PostgreSQL High Availability Manager
After=network-online.target etcd.service
Wants=network-online.target
# Patroni can use any healthy etcd member; local etcd maintenance must not stop it.
Wants=etcd.service

[Service]
Type=simple
User=postgres
Group=postgres
Environment=PATH=/usr/lib/postgresql/{{ postgresql_version }}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/patroni /etc/patroni/patroni.yml
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
LimitNOFILE=262144

[Install]
WantedBy=multi-user.target
