scope: {{ postgres_cluster_name }}
namespace: {{ patroni_namespace }}
name: {{ inventory_hostname }}

log:
  level: INFO
  traceback_level: ERROR
  deduplicate_heartbeat_logs: false

restapi:
  listen: {{ ansible_host }}:{{ patroni_rest_port }}
  connect_address: {{ ansible_host }}:{{ patroni_rest_port }}
  authentication:
    username: {{ patroni_rest_username }}
    password: {{ vault_patroni_rest_password }}

etcd3:
  hosts:
{% for host in groups['postgresql_cluster'] %}
    - {{ hostvars[host].ansible_host }}:{{ etcd_client_port }}
{% endfor %}

bootstrap:
  dcs:
    ttl: {{ patroni_ttl }}
    loop_wait: {{ patroni_loop_wait }}
    retry_timeout: {{ patroni_retry_timeout }}
    maximum_lag_on_failover: {{ patroni_maximum_lag_on_failover }}
    synchronous_mode: {{ patroni_synchronous_mode | bool | lower }}
    synchronous_mode_strict: {{ patroni_synchronous_mode_strict | bool | lower }}
    synchronous_node_count: {{ patroni_synchronous_node_count }}
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        password_encryption: scram-sha-256
        max_connections: {{ postgresql_max_connections }}
        shared_buffers: {{ postgresql_shared_buffers }}
        effective_cache_size: {{ postgresql_effective_cache_size }}
        maintenance_work_mem: {{ postgresql_maintenance_work_mem }}
        work_mem: {{ postgresql_work_mem }}
        wal_level: replica
        wal_compression: 'on'
        wal_keep_size: {{ postgresql_wal_keep_size }}
        max_wal_size: {{ postgresql_max_wal_size }}
        min_wal_size: {{ postgresql_min_wal_size }}
        max_wal_senders: 10
        max_replication_slots: 10
        hot_standby: 'on'
        max_worker_processes: 8
        max_parallel_workers: 8
        max_parallel_workers_per_gather: 4
        logging_collector: 'on'
        log_directory: /var/log/postgresql
        log_filename: postgresql-%Y-%m-%d_%H%M%S.log
        log_rotation_age: 1d
        log_rotation_size: 100MB
        log_truncate_on_rotation: 'on'
        log_line_prefix: '%m [%p] %q%u@%d '
        log_checkpoints: 'on'
        log_lock_waits: 'on'
        log_temp_files: 10240
        log_autovacuum_min_duration: 1000
        log_min_duration_statement: {{ postgresql_log_min_duration_statement_ms }}
  initdb:
    # SECURITY:
    # PostgreSQL initdb defaults to trust authentication when auth methods are
    # not specified. Keep Unix-socket administration on peer authentication
    # and require SCRAM for TCP from the very first bootstrap.
    - auth-local: peer
    - auth-host: scram-sha-256
    - encoding: UTF8
    - locale: C.UTF-8
    - data-checksums
  pg_hba:
    - local all all peer
    - host all all 127.0.0.1/32 scram-sha-256
{% for host in groups['postgresql_cluster'] %}
    - host replication {{ patroni_replication_username }} {{ hostvars[host].ansible_host }}/32 scram-sha-256
    - host all {{ patroni_rewind_username }} {{ hostvars[host].ansible_host }}/32 scram-sha-256
    - host all all {{ hostvars[host].ansible_host }}/32 scram-sha-256
{% endfor %}
{% for rule in postgresql_hba_additional_rules %}
    # Optional explicit rule managed from group_vars.
    # Example:
    # host reporting reporting_user 10.50.10.0/24 scram-sha-256
    - {{ rule }}
{% endfor %}

postgresql:
  listen: {{ ansible_host }}:{{ postgresql_port }}
  connect_address: {{ ansible_host }}:{{ postgresql_port }}
  data_dir: {{ postgres_mount_point }}/{{ postgresql_version }}/patroni
  bin_dir: /usr/lib/postgresql/{{ postgresql_version }}/bin
  pgpass: {{ postgres_mount_point }}/.pgpass
  authentication:
    superuser:
      username: {{ patroni_superuser_username }}
      password: {{ vault_postgres_superuser_password }}
    replication:
      username: {{ patroni_replication_username }}
      password: {{ vault_postgres_replication_password }}
    rewind:
      username: {{ patroni_rewind_username }}
      password: {{ vault_postgres_rewind_password }}
  parameters:
    unix_socket_directories: /var/run/postgresql
  create_replica_methods:
    - basebackup
  basebackup:
    checkpoint: fast
  use_unix_socket: true

watchdog:
  mode: off

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false
