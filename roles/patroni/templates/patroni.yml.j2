scope: {{ postgres_cluster_name | to_json }}
namespace: {{ patroni_namespace | to_json }}
name: {{ inventory_hostname | to_json }}

log:
  level: INFO
  traceback_level: ERROR
  deduplicate_heartbeat_logs: false

restapi:
  listen: {{ ansible_host }}:{{ patroni_rest_port }}
  connect_address: {{ ansible_host }}:{{ patroni_rest_port }}
  authentication:
    username: {{ patroni_rest_username | to_json }}
    password: {{ vault_patroni_rest_password | to_json }}
{% if patroni_rest_tls_enabled | bool %}
  certfile: {{ patroni_rest_tls_cert_file | to_json }}
  keyfile: {{ patroni_rest_tls_key_file | to_json }}
  cafile: {{ patroni_rest_tls_ca_file | to_json }}
  verify_client: {{ patroni_rest_tls_verify_client | to_json }}
{% endif %}

etcd3:
  hosts:
{% for host in groups['postgresql_cluster'] %}
    - {{ hostvars[host].ansible_host }}:{{ etcd_client_port }}
{% endfor %}
{% if etcd_tls_enabled | bool %}
  protocol: https
  cacert: {{ etcd_tls_ca_file | to_json }}
  cert: {{ etcd_tls_client_cert_file | to_json }}
  key: {{ etcd_tls_client_key_file | to_json }}
{% endif %}

bootstrap:
  dcs:
{{ patroni_dynamic_configuration | to_nice_yaml(indent=2, sort_keys=False) | indent(4, true) }}
  initdb:
    # SECURITY:
    # PostgreSQL initdb defaults to trust authentication when auth methods are
    # not specified. Keep Unix-socket administration on peer authentication
    # and require SCRAM for TCP from the very first bootstrap.
    - auth-local: peer
    - auth-host: scram-sha-256
    - encoding: UTF8
    - locale: C.UTF-8
    - data-checksums
  pg_hba:
    - local all all peer
    - host all all 127.0.0.1/32 scram-sha-256
{% for host in groups['postgresql_cluster'] %}
    - host replication {{ patroni_replication_username }} {{ hostvars[host].ansible_host }}/32 scram-sha-256
    - host all {{ patroni_rewind_username }} {{ hostvars[host].ansible_host }}/32 scram-sha-256
    - host all all {{ hostvars[host].ansible_host }}/32 scram-sha-256
{% endfor %}
{% for rule in postgresql_hba_additional_rules %}
    # Optional explicit rule managed from group_vars.
    # Example:
    # host reporting reporting_user 10.50.10.0/24 scram-sha-256
    - {{ rule | to_json }}
{% endfor %}

postgresql:
  listen: {{ ansible_host }}:{{ postgresql_port }}
  connect_address: {{ ansible_host }}:{{ postgresql_port }}
  data_dir: {{ postgres_mount_point }}/{{ postgresql_version }}/patroni
  bin_dir: /usr/lib/postgresql/{{ postgresql_version }}/bin
  pgpass: {{ postgres_mount_point }}/.pgpass
  authentication:
    superuser:
      username: {{ patroni_superuser_username | to_json }}
      password: {{ vault_postgres_superuser_password | to_json }}
    replication:
      username: {{ patroni_replication_username | to_json }}
      password: {{ vault_postgres_replication_password | to_json }}
      sslmode: {{ postgresql_tls_internal_sslmode | to_json }}
{% if postgresql_tls_internal_sslmode in ['verify-ca', 'verify-full'] %}
      sslrootcert: {{ postgresql_tls_ca_file | to_json }}
{% endif %}
    rewind:
      username: {{ patroni_rewind_username | to_json }}
      password: {{ vault_postgres_rewind_password | to_json }}
      sslmode: {{ postgresql_tls_internal_sslmode | to_json }}
{% if postgresql_tls_internal_sslmode in ['verify-ca', 'verify-full'] %}
      sslrootcert: {{ postgresql_tls_ca_file | to_json }}
{% endif %}
  parameters:
    unix_socket_directories: /var/run/postgresql
{% if postgresql_tls_activation_enabled | bool %}
    ssl: 'on'
    ssl_cert_file: {{ postgresql_tls_server_cert_file | to_json }}
    ssl_key_file: {{ postgresql_tls_server_key_file | to_json }}
    ssl_ca_file: {{ postgresql_tls_ca_file | to_json }}
    ssl_min_protocol_version: {{ postgresql_tls_min_protocol_version | to_json }}
{% endif %}
  create_replica_methods:
    - basebackup
  basebackup:
    checkpoint: fast
  use_unix_socket: true

watchdog:
  mode: "off"

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false
