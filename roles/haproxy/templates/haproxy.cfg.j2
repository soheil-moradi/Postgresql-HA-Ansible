global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    maxconn 4096


defaults
    log global
    mode tcp
    option tcplog
    option dontlognull
    timeout connect 5s
    timeout client 1h
    timeout server 1h
    timeout check 5s
    retries 3

frontend postgresql_primary
    bind {{ postgres_cluster_vip }}:{{ haproxy_postgresql_port }}
    mode tcp
    default_backend patroni_primary_nodes

backend patroni_primary_nodes
    mode tcp
    option httpchk GET /primary
    http-check expect status 200
{% for host in groups['postgresql_cluster'] %}
    server {{ host }} {{ hostvars[host].ansible_host }}:{{ postgresql_port }} check port {{ patroni_rest_port }} inter 2s fall 3 rise 2 on-marked-down shutdown-sessions
{% endfor %}

listen local_stats
    bind {{ haproxy_stats_bind }}:{{ haproxy_stats_port }}
    mode http
    stats enable
    stats uri /stats
    stats refresh 10s

{% if haproxy_prometheus_enabled | default(false) %}
# BEGIN ANSIBLE MANAGED HAPROXY PROMETHEUS
#
# HAProxy built-in Prometheus exporter (PROMEX).
# Bind to the DB node address, not 0.0.0.0.
#
# When postgresql_monitoring_cidrs is populated, access is additionally
# restricted at HAProxy itself. Firewall enforcement should later use the same
# reviewed monitoring CIDRs.
frontend prometheus_metrics
    bind {{ ansible_host }}:{{ haproxy_prometheus_port | default(8404) }}
    mode http

{% if postgresql_monitoring_cidrs | default([]) | length > 0 %}
    acl prometheus_allowed_source src {{ (postgresql_monitoring_cidrs + (groups['postgresql_cluster'] | map('extract', hostvars, 'ansible_host') | list)) | join(' ') }}
    http-request deny unless prometheus_allowed_source
{% endif %}

    http-request use-service prometheus-exporter if { path {{ haproxy_prometheus_path | default('/metrics') }} }
    http-request deny
    no log
# END ANSIBLE MANAGED HAPROXY PROMETHEUS
{% endif %}
